{
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://farmer-selling-app.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://farmer-selling-app.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
